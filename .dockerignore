# Dependencies (reinstalled with `npm ci` in the build stage)
node_modules
**/node_modules
jspm_packages
bower_components
.npm
.yarn
.pnpm-store

# Version control
.git
.gitignore
.gitattributes
.github
.gitlab-ci.yml

# Tests and coverage
test
tests
__tests__
**/*.test.js
**/*.spec.js
coverage
.nyc_output
jest.config.*
.mocharc*

# Secrets and local environment files
.env
.env.*
*.pem
*.key
*.crt
.npmrc
.aws
secrets

# Logs and runtime artefacts
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pids
*.pid
tmp
.cache

# Build output from the host (the image builds its own)
dist
build

# Docker and CI files (not needed inside the image)
Dockerfile*
.dockerignore
docker-compose*.yml
compose*.yml
.trivyignore

# Documentation
*.md
docs

# Editor, IDE and OS files
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Linters and formatters
.eslintrc*
.eslintcache
.prettierrc*
.editorconfig
